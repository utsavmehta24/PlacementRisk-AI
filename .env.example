# Database
POSTGRES_USER=placementrisk
POSTGRES_PASSWORD=changeme
POSTGRES_DB=placementrisk
POSTGRES_URL=postgresql://placementrisk:changeme@postgres:5432/placementrisk

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=changeme_this_is_a_secret_key_for_jwt_tokens
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql://placementrisk:changeme@postgres:5432/airflow
AIRFLOW__CORE__FERNET_KEY=changeme_fernet_key_here
AIRFLOW__CORE__LOAD_EXAMPLES=False

# API
API_HOST=0.0.0.0
API_PORT=8000

# Frontend
REACT_APP_API_URL=http://localhost:8000

# Model Settings
MODEL_SEED=42
PLACEMENT_AUC_TARGET=0.82
SALARY_MAE_TARGET=30000
